# Maintune v0.1.0-preview.1
# Copy to .env and replace every CHANGE_ME value. Installers generate these
# secrets automatically and never print them.
MAINTAINER_ADMIN_TOKEN=CHANGE_ME_RANDOM_32_BYTES_OR_MORE
MAINTAINER_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
MAINTAINER_VERSION=0.1.0-preview.1
MAINTAINER_PORT=8000
MAINTAINER_BIND_ADDRESS=127.0.0.1
MAINTAINER_DATA_DIR=./data
# Standard proxy variables are forwarded only to Docker build when configured.
# HTTP_PROXY=http://proxy.example:8080
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1
